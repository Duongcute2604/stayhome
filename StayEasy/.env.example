# ============================================================================
# STAYEASY - BIẾN MÔI TRƯỜNG (ENVIRONMENT VARIABLES)
# ============================================================================
# Mục đích: Mẫu cấu hình biến môi trường cho hệ thống StayEasy
# Cách dùng:
#   1. Copy file này thành .env: cp .env.example .env
#   2. Điền giá trị thật vào file .env
#   3. KHÔNG commit file .env vào Git (đã có trong .gitignore)
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION - Cấu hình kết nối MySQL
# ============================================================================
# Tại sao cần: Backend cần thông tin kết nối để truy cập database
# ============================================================================

# Host của MySQL (trong Docker Compose: mysql, localhost: máy thật)
MYSQL_HOST=localhost

# Port mặc định của MySQL
MYSQL_PORT=3306

# Tên database (phải khớp với MYSQL_DATABASE trong docker-compose.yml)
MYSQL_DATABASE=StayEasy

# User để kết nối database
MYSQL_USER=stayeasy

# Mật khẩu database (đổi thành mật khẩu mạnh trong production)
MYSQL_PASSWORD=stayeasy123

# Mật khẩu root (chỉ dùng trong Docker, không dùng khi kết nối app)
MYSQL_ROOT_PASSWORD=root123

# ============================================================================
# JWT CONFIGURATION - Cấu hình xác thực JWT
# ============================================================================
# Tại sao cần: JWT dùng để xác thực người dùng giữa các request
# ============================================================================

# Secret key để ký JWT (đổi thành chuỗi ngẫu nhiên dài trong production)
# Tại sao quan trọng: Nếu lộ secret, attacker có thể giả mạo token
JWT_SECRET=your-super-secret-key-change-in-production-min-32-chars

# Issuer - tên của hệ thống phát hành token
JWT_ISSUER=StayEasy

# Audience - đối tượng được phép dùng token
JWT_AUDIENCE=StayEasyUsers

# Thời gian hết hạn của token (giờ)
JWT_EXPIRATION_HOURS=24

# ============================================================================
# API CONFIGURATION - Cấu hình API
# ============================================================================

# URL của backend API (dùng ở frontend)
API_URL=http://localhost:5000/api

# Port của backend (trong container)
BACKEND_PORT=5000

# Port của frontend (trong container)
FRONTEND_PORT=3000

# ============================================================================
# CORS CONFIGURATION - Cấu hình Cross-Origin Resource Sharing
# ============================================================================
# Tại sao cần: Cho phép frontend gọi API từ domain khác
# ============================================================================

# Domain được phép gọi API (cách nhau bởi dấu phẩy)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
